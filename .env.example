# .env.example — copy to .env and fill in real values before running
# NEVER commit .env to version control.
#
#   cp .env.example .env
#   nano .env

# ── Node ──────────────────────────────────────────────────────────────────────
# Keystore encryption password. Also accepted as QBC_PASSWORD env var.
# Use a strong password (24+ random characters).
QBC_PASSWORD=change-me-before-use

# ── Docker Compose ────────────────────────────────────────────────────────────
# Grafana admin password (only relevant when --profile monitoring is active).
GRAFANA_PASSWORD=admin

# ── Optional: Docker registry for the docker-push Makefile target ─────────────
# REGISTRY=ghcr.io/qbc-qubitscoin
